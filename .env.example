# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
#
# Values come from the Supabase dashboard:
#   Project Settings -> API        (URL, anon key, service role key)
#   Project Settings -> Database   (database password, for the CLI only)

# ---------------------------------------------------------------- public
# Shipped to the browser. Not secret — this key is designed to be public,
# and it is safe ONLY because Row-Level Security is enabled on every table.
# That is why scripts/check_rls.py is a build gate.
#
# These two are all `npm run dev` needs. Nothing in the application reads
# the service-role key below — no page, no server action — and that is
# deliberate: every screen runs as the signed-in user so the policies apply.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API -> "Publishable key" (sb_publishable_...). The
# dashboard shows this name now; NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is
# also accepted if that's the label you copied. Older projects still show
# a "legacy anon key" (a long JWT) here instead — that works too.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- secret
# BYPASSES ROW-LEVEL SECURITY. Full read/write across every club.
# Server-side only. Never prefix with NEXT_PUBLIC_, never send to a browser,
# never paste into a chat, an issue, or a commit.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by the Supabase CLI for migrations.
# Not needed by the application at run time.
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------ messaging
# The site's own absolute URL. An unsubscribe link is read from an inbox,
# so it cannot be relative (BR128).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET. Derives every unsubscribe token: token = HMAC(this, row salt).
# Server-side only, never NEXT_PUBLIC_. Rotating it invalidates every
# unsubscribe link already sitting in somebody's inbox, so rotate it
# deliberately or not at all (docs/decisions/12_*.md).
MESSAGING_UNSUBSCRIBE_SECRET=

# The transactional email provider. Leave BOTH blank to run without one:
# messages are then composed, suppression is still applied and recorded,
# and the send fails loudly rather than reporting a success nobody got.
MESSAGING_PROVIDER_API_KEY=
MESSAGING_FROM_ADDRESS=

# ------------------------------------------------------- platform alerts
# Where a club's expression of interest is emailed when it arrives. Usually
# a shared inbox somebody actually watches, not a personal address — it is
# operator configuration, not a lookup of who is on the platform_admin
# allowlist (BR146, and the enquiry page is reachable by anyone, so that
# path must never hold an address list or a service-role key).
#
# Leave blank to run without alerts: the enquiry is still recorded and still
# appears at /platform, and the row records that nobody was told.
PLATFORM_ALERT_TO=

# ------------------------------------------------------- scheduled jobs
# SECRET. Checked against the bearer token Vercel Cron sends automatically
# on every scheduled invocation (see vercel.json) — a cron route has no
# signed-in user, so this is what stops anyone who finds the URL from
# triggering it. Any long random string; generate one and never reuse it
# for anything else.
CRON_SECRET=
